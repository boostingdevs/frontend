---
import Logo from "../../../assets/logo.svg?react";
import { Button } from "@/shared/components/ui/button";
---

<header
  class="w-full mx-auto py-6 bg-neutral-950 text-neutral-100 z-50 sticky top-0"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6">
    <h1 class="cursor-pointer w-40 text-neutral-100">
      <Logo className="w-full h-auto fill-current" />
    </h1>
    <nav class="flex items-center justify-between gap-6">
      <ul class="flex items-center gap-4">
        <Button variant="link">Roadmaps</Button>
      </ul>
      <div class="flex items-center gap-2">
        <Button variant="ghost">Login</Button>
        <Button variant="outline">Sign up</Button>
      </div>
    </nav>
  </div>
</header>
