---
import logo from "../../../assets/logo.svg";
import { Button } from "@/shared/components/ui/button";
---

<header class="w-full mx-auto py-6 bg-neutral-950 text-neutral-100">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <h1 class="cursor-pointer">
      <img src={logo.src} alt="Boosting Devs" class="w-40" />
    </h1>
    <nav class="flex items-center justify-between gap-6">
      <ul class="flex items-center gap-4">
        <Button variant="link">Roadmaps</Button>
      </ul>
      <div class="flex items-center gap-2">
        <Button variant="ghost">Login</Button>
        <Button variant="outline">Sign up</Button>
      </div>
    </nav>
  </div>
</header>
